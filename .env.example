# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际配置
# ============================================================

# ---------- LLM 配置 ----------
DEEPSEEK_API_KEY=sk-your-api-key-here

# ---------- 嵌入模型配置（可选）----------
# 嵌入模型路径：
# - 留空或不设置：使用默认相对路径 models/bge-small-zh-v1.5
# - 绝对路径：如 D:\models\bge-small-zh-v1.5 或 /home/user/models/bge-small-zh-v1.5
# - HuggingFace 模型名：如 BAAI/bge-small-zh-v1.5（需联网下载）
# EMBEDDING_MODEL_PATH=D:\code2\models\bge-small-zh-v1.5
